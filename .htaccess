# Cardon bleu – server settings for Apache / LiteSpeed

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
  # Everything is inline and same-origin; no third-party requests at all
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
</IfModule>

# Correct type for the web app manifest
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Caching: page, manifest and service worker always fresh; icons may be cached for a week
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest|js|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Never serve repository files
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule ^(README\.md|LICENSE|dev\.html)$ - [F,L]
</IfModule>
